# ClaimGuard local development defaults.
# Copy to .env and replace any value marked CHANGEME before a public deploy.
# These defaults are intentionally insecure and local-only.

APP_ENV=local
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000

# ClaimGuard application database (pgvector). Separate from Langfuse's Postgres.
# Fly/Railway often attach postgres:// — Settings rewrites that to postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://claimguard:claimguard@localhost:5434/claimguard

# Redis: db0 = app cache / health, db1 = Celery broker + results
REDIS_AUTH=claimguard-redis
REDIS_URL=redis://:claimguard-redis@localhost:6379/0
CELERY_BROKER_URL=redis://:claimguard-redis@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:claimguard-redis@localhost:6379/1

# Dense embeddings — BAAI/bge-base-en-v1.5 (768-d). Change + remigrate if you swap models.
EMBEDDING_DIM=768
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Model routing (unused in Phase 0; wired in later phases)
CHEAP_MODEL=openai/gpt-4o-mini
FRONTIER_MODEL=openai/gpt-4o
OPENAI_API_KEY=

# Graph hard gates: human review if confidence < X OR fraud_score > Y
ROUTING_CONFIDENCE_THRESHOLD=0.65
ROUTING_FRAUD_SCORE_THRESHOLD=0.45

# Shared-secret stub for /v1 (header X-API-Key). Not OAuth — rotate before any shared host.
CLAIMGUARD_API_KEY=claimguard-local
# Writes only (upload/submit). Dashboard list/metrics polls do not consume this.
RATE_LIMIT_PER_MINUTE=120

# Langfuse (self-hosted). Init keys are seeded by the langfuse-web container.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-claimguard-local
LANGFUSE_SECRET_KEY=sk-lf-claimguard-local
LANGFUSE_INIT_USER_EMAIL=dev@claimguard.local
LANGFUSE_INIT_USER_PASSWORD=claimguarddev

# Langfuse container secrets — local-only placeholders. CHANGEME for any shared host.
LANGFUSE_NEXTAUTH_SECRET=claimguard-local-nextauth-secret
LANGFUSE_SALT=claimguard-local-salt
LANGFUSE_ENCRYPTION_KEY=a1b2c3d4e5f6789012345678abcdef00a1b2c3d4e5f6789012345678abcdef00
LANGFUSE_DB_PASSWORD=langfuse
CLICKHOUSE_PASSWORD=clickhouse
MINIO_ROOT_PASSWORD=miniosecret
