# Local secrets — never commit
.env
.env.local
.env.*.local

# Python
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Node / Next.js
apps/frontend/node_modules/
apps/frontend/.next/
apps/frontend/out/

# Eval artifacts (generated per run)
eval_runs/*.json
eval_runs/*.md
!eval_runs/.gitkeep

# Generated synthetic blobs can be large; keep the directory, not the dumps
data/synthetic_claims/**/*.pdf
data/synthetic_claims/**/*.png
data/synthetic_claims/**/*.jpg
!data/**/.gitkeep
!data/**/README.md

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Docker
*.log
