# Local secrets — never commit
.env
.env.local
.env.*.local

# Python
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Node / Next.js
apps/frontend/node_modules/
apps/frontend/.next/
apps/frontend/out/

# Eval artifacts (generated per run). Published v0 holdout is checked in.
eval_runs/*.json
eval_runs/*.md
!eval_runs/.gitkeep
!eval_runs/v0.json
!eval_runs/v0.md

# Rebuildable retrieval artifacts
data/indexes/*.pkl
!data/indexes/.gitkeep

# Uploaded claim folders (generated at submit time)
data/uploads/*
!data/uploads/.gitkeep

# Hugging Face / FastEmbed caches
.cache/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Docker
*.log

# Playwright capture scratch (the published mp4 is kept)
docs/demo/raw/
